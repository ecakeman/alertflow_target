# Fault Lab runtime configuration.
# Copy to .env (which is git-ignored) and fill in real values.
# Never commit real tokens.

# Listen address. ":8090" binds 0.0.0.0:8090; use "127.0.0.1:8090" for local only.
SIMULATOR_ADDR=:8090

# Where the simulator persists its single JSON configuration file.
SIMULATOR_CONFIG_PATH=./config/simulator.json

# Required. Bearer token that protects the console-only /control/v1 endpoints.
# Leave empty here; set a strong random value in the real deployment.
SIMULATOR_CONTROL_TOKEN=

# Optional. When set, the Agent must present this token to read diagnostics.
SIMULATOR_DIAGNOSTICS_TOKEN=

# Log level: debug | info | warning | error
SIMULATOR_LOG_LEVEL=info

# Optional. Directory of the built frontend to serve. Defaults to ./frontend/dist.
# SIMULATOR_FRONTEND_DIST=./frontend/dist
